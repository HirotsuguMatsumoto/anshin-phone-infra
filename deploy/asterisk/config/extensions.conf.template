[general]
static=yes
writeprotect=yes
clearglobalvars=no

[globals]
TEL_DID=__TEL_DID__
FAX_DID=__FAX_DID__
SMARTPHONE_EXTENSION=__SMARTPHONE_EXTENSION__
TENANT_ID=__TENANT_ID__

[from-carrier]
exten => __TEL_DID__,1,NoOp(Anshin Phone inbound TEL)
 same => n,Set(PHASE1_DIRECTION=inbound)
 same => n,Set(PHASE1_DID=${TEL_DID})
 same => n,Set(PHASE1_REMOTE_MASKED=${CALLERID(num):0:3}****${CALLERID(num):-4})
 same => n,Set(PHASE1_STARTED_AT=${STRFTIME(${EPOCH},,%Y-%m-%dT%H:%M:%SZ)})
 same => n,Set(CHANNEL(hangup_handler_push)=phase1-hangup,s,1)
 same => n,AGI(pbx_management.py,inbound,${EXTEN},${UNIQUEID})
 same => n,GotoIf($["${PHONE_ROUTE_ALLOWED}"!="1"]?denied)
 same => n,Dial(${PHONE_ROUTE_TARGETS},30,U(phase1-answer))
 same => n(denied),Hangup(21)
 same => n,Hangup()

exten => __FAX_DID__,1,NoOp(Anshin Phone inbound FAX)
 same => n,AGI(pbx_management.py,fax,${EXTEN})
 same => n,GotoIf($["${PHONE_ROUTE_ALLOWED}"!="1"]?denied)
 same => n,Set(FAX_FILE=/var/spool/asterisk/fax/${STRFTIME(${EPOCH},,%Y%m%d-%H%M%S)}-${UNIQUEID}.tif)
 same => n,Answer()
 same => n,Wait(2)
 same => n,ReceiveFAX(${FAX_FILE},__FAX_OPTIONS__)
 same => n,Set(PHASE1_FAX_STATUS=${IF($["${FAXSTATUS}"=""]?UNKNOWN:${FAXSTATUS})})
 same => n,Set(PHASE1_OCCURRED_AT=${STRFTIME(${EPOCH},,%Y-%m-%dT%H:%M:%SZ)})
 same => n,Set(PHASE1_REMOTE_MASKED=${CALLERID(num):0:3}****${CALLERID(num):-4})
 same => n,AGI(pbx_event_spool.py,fax,${TENANT_ID},${FAX_DID},${UNIQUEID},inbound,${PHASE1_REMOTE_MASKED},${PHASE1_FAX_STATUS},${PHASE1_OCCURRED_AT},${FAX_FILE})
 same => n(denied),Hangup(21)

exten => _X.,1,NoOp(Reject unassigned inbound DID)
 same => n,Hangup(1)

[from-smartphone]
exten => 110,1,NoOp(Block emergency call until carrier and location requirements are approved)
 same => n,Hangup(21)
exten => 118,1,Goto(110,1)
exten => 119,1,Goto(110,1)
exten => _010X.,1,NoOp(Block international call in Phase 1)
 same => n,Hangup(21)
exten => _0570X.,1,NoOp(Block premium-rate call in Phase 1)
 same => n,Hangup(21)
exten => _0990X.,1,NoOp(Block premium-rate call in Phase 1)
 same => n,Hangup(21)
exten => _0[1-9]XXXXXXXX,1,Gosub(outbound-carrier,s,1(${EXTEN}))
 same => n,Hangup()
exten => _0[1-9]XXXXXXXXX,1,Gosub(outbound-carrier,s,1(${EXTEN}))
 same => n,Hangup()
exten => _X.,1,NoOp(Reject unsupported outbound destination)
 same => n,Hangup(21)

[outbound-carrier]
exten => s,1,NoOp(Anshin Phone outbound TEL)
 same => n,AGI(pbx_management.py,outbound,${CHANNEL(endpoint)},${UNIQUEID})
 same => n,GotoIf($["${PHONE_ROUTE_ALLOWED}"!="1"]?denied)
 same => n,Set(PHASE1_DIRECTION=outbound)
 same => n,Set(PHASE1_DID=${PHONE_ROUTE_DID})
 same => n,Set(PHASE1_REMOTE_MASKED=${ARG1:0:3}****${ARG1:-4})
 same => n,Set(PHASE1_STARTED_AT=${STRFTIME(${EPOCH},,%Y-%m-%dT%H:%M:%SZ)})
 same => n,Set(CHANNEL(hangup_handler_push)=phase1-hangup,s,1)
 same => n,Set(CALLERID(num)=${PHONE_ROUTE_DID})
 same => n,Set(PJSIP_HEADER(add,P-Asserted-Identity)=<sip:${PHONE_ROUTE_DID}@__CARRIER_HOST__>)
 same => n,Dial(PJSIP/${ARG1}@carrier-endpoint,60,U(phase1-answer))
 same => n,Return()
 same => n(denied),Hangup(21)

[phase1-answer]
exten => s,1,Set(MASTER_CHANNEL(PHASE1_ANSWERED_AT)=${STRFTIME(${EPOCH},,%Y-%m-%dT%H:%M:%SZ)})
 same => n,ExecIf($["${MASTER_CHANNEL(PHASE1_DIRECTION)}"="inbound"]?Set(MASTER_CHANNEL(PHASE1_ANSWERED_EXTENSION)=${CHANNEL(endpoint)}))
 same => n,Return()

[phase1-hangup]
exten => s,1,NoOp(Phase1 call ended uniqueid=${UNIQUEID} disposition=${DIALSTATUS})
 same => n,NoOp(phase=voice-media direction=${PHASE1_DIRECTION} rx=${CHANNEL(rtcp,rxcount,audio)} tx=${CHANNEL(rtcp,txcount,audio)})
 same => n,Set(PHASE1_DISPOSITION=${IF($["${DIALSTATUS}"=""]?UNKNOWN:${DIALSTATUS})})
 same => n,Set(PHASE1_ENDED_AT=${STRFTIME(${EPOCH},,%Y-%m-%dT%H:%M:%SZ)})
 same => n,AGI(pbx_event_spool.py,call,${TENANT_ID},${PHASE1_DID},${UNIQUEID},${PHASE1_DIRECTION},${PHASE1_REMOTE_MASKED},${PHASE1_DISPOSITION},${PHASE1_STARTED_AT},${IF($["${PHASE1_ANSWERED_AT}"=""]?-:${PHASE1_ANSWERED_AT})},${PHASE1_ENDED_AT},${IF($["${PHASE1_ANSWERED_EXTENSION}"=""]?-:${PHASE1_ANSWERED_EXTENSION})})
 same => n,Return()

[fax-dispatch]
exten => _[0-9a-f].,1,NoOp(Anshin Phone isolated FAX job)
 same => n,Set(TIMEOUT(absolute)=180)
 same => n,AGI(pbx_fax_worker.py,prepare,${EXTEN},${FAX_QUEUED_CLAIM_ID})
 same => n,GotoIf($["${FAX_JOB_READY}"!="1"]?denied)
 same => n,Set(CHANNEL(hangup_handler_push)=fax-job-hangup,s,1)
 same => n,Set(CALLERID(num)=${FAX_SOURCE})
 same => n,Dial(PJSIP/${FAX_DESTINATION}@carrier-endpoint,45,U(fax-transmit))
 same => n(denied),Hangup()

[fax-transmit]
exten => s,1,Set(CHANNEL(hangup_handler_push)=fax-send-hangup,s,1)
 same => n,SendFAX(${FAX_SEND_FILE},__FAX_OPTIONS__)
 same => n,Set(GOSUB_RESULT=ABORT)
 same => n,Return()

[fax-send-hangup]
exten => s,1,AGI(pbx_fax_worker.py,complete,${FAX_JOB_ID},${FAX_CLAIM_ID},${IF($["${FAXSTATUS}"=""]?UNKNOWN:${FAXSTATUS})},ANSWER)
 same => n,Return()

[fax-job-hangup]
exten => s,1,GotoIf($["${DIALSTATUS}"="ANSWER"]?done)
 same => n,AGI(pbx_fax_worker.py,complete,${FAX_JOB_ID},${FAX_CLAIM_ID},UNKNOWN,${IF($["${DIALSTATUS}"=""]?UNKNOWN:${DIALSTATUS})})
 same => n(done),Return()

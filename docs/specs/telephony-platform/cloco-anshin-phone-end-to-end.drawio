    <diagram id="physical-phase1" name="02_物理構成_Phase1">
        <mxGraphModel dx="1784" dy="1088" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1500" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="P_title" value="Cloco × アンシンフォン　物理構成（Phase 1配置計画）" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#172B4D;" parent="1" vertex="1">
                    <mxGeometry x="40" y="20" width="2220" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="P_subtitle" value="Phone専用の公開計算基盤（provider・IP未選定）上のDocker構成。外部公開はKamailioとRTPengineだけ。Asterisk・Backend・PostgreSQLは内部networkへ隔離する。" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#5E6C84;" parent="1" vertex="1">
                    <mxGeometry x="40" y="68" width="2220" height="34" as="geometry"/>
                </mxCell>
                <mxCell id="P_external_zone" value="外部利用者 / 公衆電話網" style="swimlane;html=1;rounded=1;startSize=36;horizontal=1;fontSize=16;fontStyle=1;fillColor=#F2F2F2;strokeColor=#7F8C8D;" parent="1" vertex="1">
